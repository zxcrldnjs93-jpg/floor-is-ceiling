{
  "cases": [
    {
      "name": "첫 방문 320px 터치와 6층에서 같은 쿵",
      "viewport": { "width": 320, "height": 568, "mobile": true },
      "cues": [
        { "at": 0, "expect": { "state": "v04-s0-ready", "wait": 2 } },
        { "at": 0, "snapshot": "s0-before" },
        { "at": 0.3, "clickAt": { "selector": "#s0 .drop-invite.is-invite .inv-drop .dp-ball", "scope": "#s0 [data-stage='s0']" } },
        { "at": 0.3, "expect": { "state": "v04-s0-recorded", "wait": 3 } },
        { "at": 0.3, "snapshot": "s0-after" },
        { "at": 1.9, "scroll": { "scene": "s2", "progress": 0.35, "seconds": 0.7 } },
        { "at": 2.65, "expect": { "state": "v04-s2-same-event", "wait": 4, "stable": 3 } },
        { "at": 2.65, "snapshot": "s2-same" }
      ]
    },
    {
      "name": "390px 움직임 줄이기에서도 안내와 쿵 인계",
      "viewport": { "width": 390, "height": 844, "mobile": true, "reducedMotion": true },
      "cues": [
        { "at": 0, "expect": { "state": "v04-s0-ready", "wait": 2, "reduced": true } },
        { "at": 0.25, "clickAt": { "selector": "#s0 .drop-invite.is-invite .inv-tap .inv-ring", "scope": "#s0 [data-stage='s0']", "target": "#s0 [data-hit='7'][data-action='tap']" } },
        { "at": 0.25, "expect": { "state": "v04-s0-recorded", "wait": 3 } },
        { "at": 0.25, "snapshot": "s0-after-reduced" },
        { "at": 1.7, "scroll": { "scene": "s2", "progress": 0.35, "seconds": 0 } },
        { "at": 1.75, "expect": { "state": "v04-s2-same-event", "wait": 4, "stable": 3 } },
        { "at": 1.75, "snapshot": "s2-same-reduced" }
      ]
    },
    {
      "name": "노트북 Tab·Enter로 낙하 두 번, 6층 최대 쿵과 다시 듣기",
      "viewport": { "width": 1280, "height": 720 },
      "cues": [
        { "at": 0, "expect": { "state": "v04-s0-ready", "wait": 2 } },
        { "at": 0.25, "tabTo": "#s0 button[data-action='drop']" },
        { "at": 0.25, "expect": { "state": "v04-s0-focus-preview", "action": "drop", "wait": 2 } },
        { "at": 0.25, "snapshot": "s0-keyboard-focus" },
        { "at": 0.25, "enter": "#s0 button[data-action='drop']" },
        { "at": 0.25, "expect": { "state": "v04-s0-recorded", "wait": 3 } },
        { "at": 1.95, "tabTo": "#s0 button[data-action='drop-high']" },
        { "at": 1.95, "expect": { "state": "v04-s0-focus-preview", "action": "drop-high", "wait": 2 } },
        { "at": 1.95, "snapshot": "s0-keyboard-high" },
        { "at": 1.95, "enter": "#s0 button[data-action='drop-high']" },
        { "at": 1.95, "expect": { "state": "v04-s0-recorded", "count": 2, "peakValue": 200, "wait": 3 } },
        { "at": 3.55, "scroll": { "scene": "s2", "progress": 0.35, "seconds": 0.65 } },
        { "at": 3.6, "expect": { "state": "v04-s2-same-event", "peakValue": 200, "wait": 5, "stable": 3 } },
        { "at": 3.6, "snapshot": "s2-peak-keyboard" },
        { "at": 7.6, "watch": "v04-s2-repeat" },
        { "at": 7.6, "click": ["#s2 button[data-action='replay']"] },
        { "at": 7.6, "expect": { "state": "v04-s2-same-event", "peakValue": 200, "repeat": true, "wait": 5, "stable": 3 } },
        { "at": 7.6, "snapshot": "s2-peak-replayed" }
      ]
    },
    {
      "name": "노트북에서 입력을 건너뛰면 6층 기준 낙하",
      "viewport": { "width": 1280, "height": 720 },
      "cues": [
        { "at": 0, "expect": { "state": "v04-s0-ready", "wait": 2 } },
        { "at": 0.25, "scroll": { "scene": "s2", "progress": 0.35, "seconds": 0.7 } },
        { "at": 0.95, "expect": { "state": "v04-s2-reference", "wait": 4, "stable": 3 } },
        { "at": 0.95, "snapshot": "s2-reference" }
      ]
    },
    {
      "name": "390px 같은 높이에서 매트 비교와 반복",
      "viewport": { "width": 390, "height": 844, "mobile": true },
      "cues": [
        { "at": 0.25, "click": ["#s0 button[data-action='drop-high']"] },
        { "at": 0.25, "expect": { "state": "v04-s0-recorded", "wait": 3 } },
        { "at": 1.8, "scroll": { "scene": "s5", "progress": 0.15, "seconds": 0 } },
        { "at": 1.85, "expect": { "state": "v04-mat-ready", "wait": 4, "heightSource": "peak" } },
        { "at": 1.85, "snapshot": "s5-before" },
        { "at": 1.85, "click": ["#s5 button[data-action='mat-before']"] },
        { "at": 1.85, "expect": { "state": "v04-mat-bare", "wait": 4, "beforeValue": 200 } },
        { "at": 1.85, "click": ["#s5 button[data-action='mat-lay']"] },
        { "at": 1.85, "expect": { "state": "v04-mat-laid", "wait": 3 } },
        { "at": 1.85, "snapshot": "s5-laid" },
        { "at": 1.85, "click": ["#s5 button[data-action='mat-after']"] },
        { "at": 1.85, "expect": { "state": "v04-mat-compared", "wait": 5 } },
        { "at": 1.85, "snapshot": "s5-compared" },
        { "at": 1.85, "click": ["#s5 button[data-action='mat-after']"] },
        { "at": 1.85, "expect": { "state": "v04-mat-repeated", "wait": 5 } },
        { "at": 1.85, "snapshot": "s5-repeated" },
        { "at": 1.85, "scroll": { "scene": "s6", "progress": 0, "seconds": 0 } },
        { "at": 1.95, "expect": { "state": "v04-mat-complete-card", "wait": 4, "beforeValue": 200 } },
        { "at": 1.95, "snapshot": "s6-mat-card" }
      ]
    },
    {
      "name": "320px에서 매트 비교를 끝내지 않고 카드 보기",
      "viewport": { "width": 320, "height": 568, "mobile": true },
      "cues": [
        { "at": 0.25, "scroll": { "scene": "s5", "progress": 0.15, "seconds": 0 } },
        { "at": 0.3, "expect": { "state": "v04-mat-ready", "wait": 4, "heightSource": "reference" } },
        { "at": 0.3, "click": ["#s5 button[data-action='mat-before']"] },
        { "at": 0.3, "expect": { "state": "v04-mat-bare", "wait": 4, "beforeValue": 100 } },
        { "at": 0.3, "snapshot": "s5-bare-only" },
        { "at": 0.3, "scroll": { "scene": "s6", "progress": 0, "seconds": 0 } },
        { "at": 0.35, "expect": { "state": "v04-mat-incomplete-card", "wait": 4, "seenFlip": false, "flipPrompt": "open" } },
        { "at": 0.35, "snapshot": "s6-incomplete-card" },
        { "at": 0.35, "reveal": "#s6 [data-flip-missed]" },
        { "at": 0.35, "expect": { "state": "v04-s6-flip-visible", "wait": 4 } },
        { "at": 0.35, "snapshot": "s6-flip-reminder" },
        { "at": 0.35, "scroll": { "scene": "s5", "progress": 0.15, "seconds": 0 } },
        { "at": 0.4, "expect": { "state": "v04-mat-bare", "wait": 4 } },
        { "at": 0.4, "click": ["#s5 button[data-action='mat-lay']"] },
        { "at": 0.4, "expect": { "state": "v04-mat-laid", "wait": 3 } },
        { "at": 0.4, "click": ["#s5 button[data-action='mat-after']"] },
        { "at": 0.4, "expect": { "state": "v04-mat-compared", "wait": 5 } },
        { "at": 0.4, "snapshot": "s5-320-compared" }
      ]
    },
    {
      "name": "노트북 드르륵이 최대면 기준 높이와 미완료 안내",
      "viewport": { "width": 1280, "height": 720 },
      "cues": [
        { "at": 0.25, "tabTo": "#s0 button[data-action='drop']" },
        { "at": 0.25, "enter": "#s0 button[data-action='drop']" },
        { "at": 0.25, "expect": { "state": "v04-s0-recorded", "wait": 3 } },
        { "at": 1.8, "scroll": { "scene": "s1", "progress": 0.15, "seconds": 0.6 } },
        { "at": 2.6, "enter": "#s1 button[data-action='drag-chair']" },
        { "at": 4.6, "expect": { "state": "chair-index" } },
        { "at": 4.65, "scroll": { "scene": "s4", "progress": 0.2, "seconds": 0.7 } },
        { "at": 5.65, "scroll": { "scene": "s4", "progress": 0.65, "seconds": 1.1 } },
        { "at": 9.05, "expect": { "state": "inverted" } },
        { "at": 9.1, "scroll": { "scene": "s4", "progress": 0.97, "seconds": 1.25 } },
        { "at": 12.5, "expect": { "state": "upright" } },
        { "at": 12.55, "scroll": { "scene": "s5", "progress": 0.15, "seconds": 0 } },
        { "at": 12.6, "expect": { "state": "v04-mat-ready", "wait": 4, "heightSource": "reference-after-drag" } },
        { "at": 12.6, "snapshot": "s5-reference-after-chair" },
        { "at": 12.6, "scroll": { "scene": "s6", "progress": 0, "seconds": 0 } },
        { "at": 12.65, "expect": { "state": "v04-mat-incomplete-card", "wait": 4, "seenFlip": true, "started": false } },
        { "at": 12.65, "snapshot": "s6-mat-reminder" },
        { "at": 12.65, "reveal": "#s6 :is([data-mat-missed], [data-recap='mat']) a[href='#s5']" },
        { "at": 12.65, "click": ["#s6 :is([data-mat-missed], [data-recap='mat']) a[href='#s5']"] },
        { "at": 12.65, "expect": { "state": "v04-mat-ready", "wait": 5, "heightSource": "reference-after-drag", "focused": "mat-before" } },
        { "at": 12.65, "snapshot": "s5-revisited" },
        { "at": 12.65, "enter": "#s5 button[data-action='mat-before']" },
        { "at": 12.65, "expect": { "state": "v04-mat-bare", "wait": 4, "beforeValue": 100 } },
        { "at": 12.65, "tabTo": "#s5 button[data-action='mat-lay']" },
        { "at": 12.65, "enter": "#s5 button[data-action='mat-lay']" },
        { "at": 12.65, "expect": { "state": "v04-mat-laid", "wait": 3 } },
        { "at": 12.65, "tabTo": "#s5 button[data-action='mat-after']" },
        { "at": 12.65, "enter": "#s5 button[data-action='mat-after']" },
        { "at": 12.65, "expect": { "state": "v04-mat-compared", "wait": 5 } },
        { "at": 12.65, "scroll": { "scene": "s6", "progress": 0, "seconds": 0 } },
        { "at": 12.7, "expect": { "state": "v04-mat-complete-card", "wait": 4 } },
        { "at": 12.7, "snapshot": "s6-reminder-cleared" },
        { "at": 12.7, "reveal": "#s6 button[data-action='restart'], #s7 a[data-action='restart'][href='#s0']" },
        { "at": 12.7, "click": ["#s6 button[data-action='restart']", "#s7 a[data-action='restart'][href='#s0']"] },
        { "at": 12.8, "expect": { "state": "v04-s0-ready", "wait": 4 } },
        { "at": 12.8, "snapshot": "s0-after-restart" }
      ]
    },
    {
      "name": "가로모드 844×390 매트 비교 수치와 안내",
      "viewport": { "width": 844, "height": 390, "mobile": true, "reducedMotion": true },
      "cues": [
        { "at": 0.25, "scroll": { "scene": "s5", "progress": 0.15, "seconds": 0 } },
        { "at": 0.3, "expect": { "state": "v04-mat-ready", "wait": 4, "heightSource": "reference" } },
        { "at": 0.3, "click": ["#s5 button[data-action='mat-before']"] },
        { "at": 0.3, "expect": { "state": "v04-mat-bare", "wait": 4 } },
        { "at": 0.3, "click": ["#s5 button[data-action='mat-lay']"] },
        { "at": 0.3, "expect": { "state": "v04-mat-laid", "wait": 3 } },
        { "at": 0.3, "click": ["#s5 button[data-action='mat-after']"] },
        { "at": 0.3, "expect": { "state": "v04-mat-compared", "wait": 5 } },
        { "at": 0.3, "snapshot": "s5-landscape-compared" }
      ]
    }
  ]
}
